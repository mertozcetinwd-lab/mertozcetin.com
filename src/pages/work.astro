---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import SelectedWork from '../components/SelectedWork.astro';
import WorkIndex from '../components/WorkIndex.astro';
import ContactCta from '../components/ContactCta.astro';
import Footer from '../components/Footer.astro';
import Mark from '../components/Mark.astro';
import { meta } from '../data/site.js';
---

<Base title={`Work — ${meta.name}`} description="Selected AI automations and agentic systems built by Mert Ozcetin.">
  {/* Was "Things I have built and actually use … the OS I run my week on" — the
      same daily-use claim as the old hero, and not true. What's true is better:
      he built all of it. */}
  <PageHead eyebrow="Selected work · 2026" title="The Work">
    <Fragment slot="lead">
      Lead generation, inbox triage, multi-perspective research, self-critiquing decks.
      Every one <Mark>shipped end to end</Mark> — real APIs, real deploys, real error handling.
    </Fragment>
  </PageHead>
  <FeaturedWork />
  <SelectedWork />
  <WorkIndex />
  <ContactCta />
  <Footer />
</Base>
