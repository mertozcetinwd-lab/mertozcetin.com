---
// Written for one reader: someone deciding whether to reply.
//
// It used to be an unbroken column of prose — nothing to look at and nothing to
// verify, which is why it read as bland. Three changes: the ask comes FIRST
// (it's the single thing a recruiter scans for, and it was buried below the
// story), the claims are backed by a strip of real shipped work pulled straight
// from projects[], and the page finally has an image.
//
// The story and the four rules stay — they're the strongest content here and
// Mert approved that direction. The fix was hierarchy, not new words.
//
// COPY IS A DRAFT pending Mert's review — CLAUDE.md: external voice is not
// calibrated, so nothing here ships unread.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ContactCta from '../components/ContactCta.astro';
import Footer from '../components/Footer.astro';
import Plate from '../components/Plate.astro';
import Mark from '../components/Mark.astro';
import { meta, stack, projects, liveCount } from '../data/site.js';

// The evidence strip. Derived, so it can never claim more than exists.
const proof = projects.filter((p) => p.featured || p.highlight).slice(0, 5);

const looking = [
  'AI roles: internship, junior, or contract. The problem matters more than the title.',
  "I'm looking for a team building real agentic systems, not demos.",
  // Remote is a constraint, not a preference. "Remote or hybrid" invited a
  // conversation that ends in a no.
  'Remote only. Based in the USA, US Eastern hours.',
];

const principles = [
  {
    title: 'Ship it end to end',
    body: 'One finished thing beats five prototypes. Every build on the work page went all the way: deployed, wired to real APIs, and handling its own errors.',
  },
  {
    title: 'Plain text beats a platform',
    body: 'My systems are markdown files and scripts. Durable, greppable, no lock-in, and readable by me or by a model.',
  },
  {
    title: 'Direct API over a wrapper',
    body: 'Fewer layers between me and the tool. It is cheaper to run, easier to control, and I actually learn how the thing works.',
  },
  {
    title: 'Write down why',
    body: 'Every real decision goes in a log with the reasoning. Future me is a different person and deserves the context.',
  },
];
---

<Base title={`About — ${meta.name}`} description={meta.intro}>
  {/* Was "I build AI automations and agentic systems. Here's where I'm at." —
      which the story's opening line below now says better, and saying it twice
      on one page made both times land softer. */}
  <PageHead
    eyebrow="Profile"
    title="About"
    lead="What I'm after, what I've built, and how I work."
  />

  {/* THE ASK FIRST. It was buried under the story; it's the one thing the reader
      came for. */}
  <section class="ask">
    <div class="wrap grid">
      <div class="want">
        <div class="section-tag reveal"><span><span class="idx">◍</span> What I'm looking for</span></div>
        <ul class="looking reveal">
          {looking.map((l) => (
            <li><span class="arrow" aria-hidden="true">→</span>{l}</li>
          ))}
        </ul>
        <p class="avail reveal">
          <span class="live-dot" aria-hidden="true"></span>{meta.status}
        </p>
      </div>

      <aside class="anchor reveal">
        <div class="art"><Plate kind="contour" seed={4} ratio="4 / 3" /></div>
        <p class="cap">Fig. — contour · drawn in code</p>
      </aside>
    </div>
  </section>

  {/* EVIDENCE, not adjectives. Derived from projects[] so it cannot overclaim. */}
  <section class="proof">
    <div class="wrap">
      <div class="section-tag reveal">
        <span><span class="idx">◍</span> Receipts</span>
        <span>{liveCount} shipped · {projects.length} total</span>
      </div>
      <ul class="strip">
        {proof.map((p, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <a href="/work">
              <span class="n">{p.idx}</span>
              <span class="t">{p.short}</span>
              <span class="k">{p.kind}</span>
            </a>
          </li>
        ))}
        <li class="reveal" style={`--i:${proof.length}`}>
          <a href="/work" class="all">All {projects.length} <span aria-hidden="true">→</span></a>
        </li>
      </ul>
    </div>
  </section>

  <section class="story">
    <div class="wrap sgrid">
      {/* BUILT, not used. The old version claimed a daily ritual — "runs on my
          inbox every morning", "how I plan my week" — that Mert doesn't actually
          have. It's also the weaker pitch: a team hires the person who can build
          the thing, not the person who uses it. */}
      <div class="prose reveal">
        <p class="big">
          I build AI <Mark display>automations</Mark> and agentic systems — the kind that
          make a decision, take an action, and know when to stop.
        </p>
        <p class="big">
          I started by automating one thing I was doing by hand. Then I built the system
          that builds them.
        </p>

        <p>
          Everything on the work page I designed, built and shipped end to end: the pipeline
          that sources leads and writes to them, the agent that qualifies the ones that come
          back, the research system that argues with itself before it files a briefing. Real
          APIs, real deploys, real error handling.
        </p>

        <p>
          I'm early, and Client Optimal is pre-revenue. Those are facts, not excuses. What I
          have is a body of work I built myself and can explain line by line.
        </p>
      </div>

      <aside class="facts reveal" aria-label="Profile">
        <dl>
          <div class="fact"><dt>Focus</dt><dd>{meta.role}</dd></div>
          <div class="fact"><dt>Studio</dt><dd>{meta.brand}</dd></div>
          <div class="fact"><dt>Based</dt><dd>{meta.location}</dd></div>
          <div class="fact"><dt>Hours</dt><dd>{meta.hours}</dd></div>
          <div class="fact"><dt>Shipped</dt><dd>{liveCount} builds</dd></div>
        </dl>
        <div class="now">
          <span class="eyebrow">Currently</span>
          <p>
            Shipping automations end to end to get faster at the thing itself, building this
            site with Claude Code, and looking for an AI internship where I'd be building
            rather than watching.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="cols">
    <div class="wrap">
      <div class="section-tag reveal"><span><span class="idx">◍</span> Stack</span></div>
      <div class="chips reveal">
        {stack.map((s) => <span class="chip">{s}</span>)}
      </div>
    </div>
  </section>

  <section class="how">
    <div class="wrap">
      <div class="section-tag reveal"><span><span class="idx">◍</span> How I work</span><span>Four rules</span></div>
      <ul class="rules">
        {principles.map((p, i) => (
          <li class="rule reveal" style={`--i:${i % 2}`}>
            <h2 class="rt display">{p.title}</h2>
            <p class="rb">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ContactCta />
  <Footer />
</Base>

<style>
  /* ---- the ask ---- */
  .ask { padding-block: clamp(2rem, 6vh, 3.5rem) clamp(1.5rem, 4vh, 2.5rem); }
  .grid { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: clamp(1.8rem, 5vw, 4rem); align-items: center; }

  .looking { display: grid; gap: 1rem; margin-top: 0.4rem; }
  .looking li {
    display: flex; gap: 0.9ch;
    font-family: var(--font-mono);
    font-size: var(--step-lead); line-height: 1.55;
    color: var(--text); max-width: 46ch;
  }
  .looking .arrow { color: var(--accent); flex: none; }
  .avail {
    display: inline-flex; align-items: center; gap: 0.95ch; margin-top: 1.8rem;
    font-family: var(--font-mono);
    font-size: var(--step-eyebrow); font-weight: 500;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted);
  }

  .anchor .art { border: 1px solid var(--hair); background: var(--bg-2); overflow: hidden; }
  .anchor .cap {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.58rem; font-weight: 500;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted);
  }

  /* ---- receipts ---- */
  .proof { padding-block: clamp(1.5rem, 4vh, 2.5rem) clamp(2rem, 5vh, 3rem); border-top: 1px solid var(--hair); }
  .strip { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .strip a {
    display: inline-flex; align-items: baseline; gap: 0.8ch;
    border: 1px solid var(--hair-2); padding: 0.6em 0.9em;
    transition: border-color 0.25s var(--ease), background-color 0.25s var(--ease);
  }
  .strip a:hover { border-color: var(--accent); background: color-mix(in srgb, var(--text) 4%, transparent); }
  .strip .n { font-family: var(--font-mono); font-size: 0.6rem; color: var(--accent); }
  .strip .t { font-family: var(--font-mono); font-size: var(--step-small); color: var(--text); white-space: nowrap; }
  .strip .k {
    font-family: var(--font-mono); font-size: 0.55rem;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
  }
  .strip .all {
    font-family: var(--font-mono); font-size: var(--step-eyebrow); font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--text);
  }

  /* ---- story ---- */
  .story { padding-block: clamp(2rem, 6vh, 4rem); border-top: 1px solid var(--hair); }
  .sgrid { display: grid; grid-template-columns: 1.35fr 0.65fr; gap: clamp(1.6rem, 5vw, 4.5rem); }
  .prose { max-width: 58ch; }
  .prose p {
    font-family: var(--font-mono);
    color: var(--text-dim); margin-bottom: 1.3rem; line-height: 1.75;
  }
  /* The opening two lines carry the voice, so they get the serif; the rest is
     the system talking and stays mono. */
  .prose .big {
    font-family: var(--font-display);
    font-weight: 500; font-variation-settings: 'opsz' 72, 'wght' 500;
    font-size: var(--step-h3); letter-spacing: var(--ls-display);
    line-height: 1.3; color: var(--text); margin-bottom: 1.4rem;
  }
  .prose p:last-child { margin-bottom: 0; }

  .facts { align-self: start; }
  .facts dl { border-top: 1px solid var(--hair-2); }
  .fact {
    display: flex; justify-content: space-between; gap: 1rem;
    padding-block: 0.8rem; border-bottom: 1px solid var(--hair);
    font-family: var(--font-mono);
    font-size: var(--step-small); letter-spacing: 0.04em; text-transform: uppercase;
  }
  .fact dt { color: var(--muted); flex: none; }
  .fact dd { color: var(--text); text-align: right; }
  .now { margin-top: 1.8rem; }
  .now .eyebrow { display: block; margin-bottom: 0.7rem; }
  .now p {
    font-family: var(--font-mono);
    font-size: var(--step-small); line-height: 1.7; color: var(--text-dim);
  }

  /* ---- stack ---- */
  .cols { padding-block: clamp(1.5rem, 4vh, 2.5rem); border-top: 1px solid var(--hair); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.4rem; }

  /* ---- how I work ---- */
  .how { padding-block: clamp(2rem, 6vh, 4rem); border-top: 1px solid var(--hair); }
  .rules {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.6rem, 3.5vw, 3rem);
    padding-top: clamp(0.5rem, 1vw, 0.9rem);
  }
  .rule { border-top: 1px solid var(--hair); padding-top: 1.1rem; }
  .rt { font-size: var(--step-h3); line-height: 1.08; margin-bottom: 0.6rem; }
  .rb {
    font-family: var(--font-mono);
    color: var(--text-dim); font-size: var(--step-small);
    line-height: 1.7; max-width: 40ch;
  }

  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; }
    .anchor { max-width: 420px; order: -1; }
    .sgrid { grid-template-columns: 1fr; gap: 2.5rem; }
    .prose { max-width: none; }
    .rules { grid-template-columns: 1fr; }
  }
</style>
