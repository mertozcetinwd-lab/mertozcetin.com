---
import { projects } from '../data/site.js';
import WorkArtifact from './WorkArtifact.astro';

// Only the highlighted builds get an artifact. Everything else is real and
// shipped too, but it lives in WorkIndex as a quiet row — four images against
// six text rows is a hierarchy; ten equal cards was the flat wall this page
// started as.
const items = projects.filter((p) => p.highlight && !p.featured);
---

<section class="work" id="work">
  <div class="wrap">
    <div class="section-tag reveal">
      <span><span class="idx">◍</span> Highlights</span>
      <span>{items.length} · 2026</span>
    </div>
    <ul class="list">
      {items.map((p, i) => {
        const isLive = p.status === 'live';
        return (
          <li class="card reveal" style={`--i:${i % 2}`}>
            <div class="art">
              <WorkArtifact
                src={p.art.src}
                focus={p.art.focus}
                ratio={p.art.ratio || '5 / 4'}
                alt={`${p.title} — real artifact`}
              />
            </div>
            <div class="body">
              <div class="top mono">
                <span class="idx">{p.idx}</span>
                <span>{p.kind}</span>
                <span>{p.year}</span>
              </div>
              <h3 class="display title">{p.title}</h3>
              <p class="summary">{p.summary}</p>
              <p class="outcome mono"><span class="arrow">→</span> {p.outcome}</p>
              <div class="tags">
                {p.tags.map((t) => <span class="chip">{t}</span>)}
              </div>
              <div class="meta mono">
                <span>{p.role}</span>
                <span class="sep">/</span>
                <span class="status">
                  {isLive && <span class="live-dot" aria-hidden="true"></span>}
                  {p.status}
                </span>
                {p.links && p.links.map((l) => (
                  <a class="link" href={l.href}>{l.label} <span aria-hidden="true">↗</span></a>
                ))}
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .work { padding-block: clamp(2rem, 5vh, 4rem) clamp(2.5rem, 7vh, 6rem); }
  .list { display: grid; border-top: 1px solid var(--hair); }
  .card {
    display: grid; grid-template-columns: 0.82fr 1.18fr;
    gap: clamp(1.2rem, 3vw, 3.2rem);
    padding-block: clamp(2rem, 5vh, 4rem);
    border-bottom: 1px solid var(--hair);
    align-items: center;
  }
  .card:nth-child(even) .art { order: 2; }
  .card .art { max-width: 440px; width: 100%; }

  .top { display: flex; gap: 1.2rem; font-size: var(--step-eyebrow); font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin-bottom: 1rem; }
  .top .idx { color: var(--text-dim); }
  .title { font-size: var(--step-h3); line-height: 1.08; margin-bottom: 0.9rem; max-width: 24ch; }
  .summary { font-family: var(--font-mono); color: var(--text-dim); max-width: 54ch; margin-bottom: 1rem; }
  .outcome { font-size: var(--step-body); color: var(--text); max-width: 48ch; margin-bottom: 1.4rem; line-height: 1.6; }
  .outcome .arrow { color: var(--muted); margin-right: 0.4ch; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.4rem; }

  .meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.55rem 0.9rem;
    font-size: var(--step-eyebrow); font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
  }
  .meta .sep { color: var(--hair-2); }
  .meta .status { display: inline-flex; align-items: center; gap: 0.5ch; color: var(--text-dim); }
  .meta .link {
    color: var(--text); border-bottom: 1px solid var(--hair-2); padding-bottom: 0.2rem;
    transition: border-color 0.25s var(--ease);
  }
  .meta .link:hover { border-color: var(--text); }

  @media (max-width: 820px) {
    .card { grid-template-columns: 1fr; }
    .card .art, .card:nth-child(even) .art { order: -1; max-width: 340px; }
  }
</style>
