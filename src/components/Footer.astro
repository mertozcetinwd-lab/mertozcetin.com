---
// Just the colophon. The 780px-tall scene that used to sit here — a giant ghosted
// OZCETIN wordmark behind a three.js moon — cost the entire three.js bundle to say
// nothing, on a page whose argument is that only real work earns attention.
import { meta, socials } from '../data/site.js';
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap row">
    <span>© {year} {meta.name}</span>
    <nav class="socials" aria-label="Social">
      {socials.map((s) => <a href={s.href}>{s.label}</a>)}
    </nav>
    <span>{meta.version}</span>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--hair); }
  .row {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    padding-block: 1.6rem;
    font-size: 0.6rem; font-weight: 500;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted);
  }
  .socials { display: flex; gap: 1.4rem; }
  .socials a { transition: color var(--t-fast) var(--ease-snap); }
  .socials a:hover { color: var(--text); }
</style>
